---
import { Icon } from 'astro-icon/components';

import { urlFor } from '../lib/sanity';

interface NavItem {
  title: string;
  url: string;
}

interface MegaMenuItem {
  label: string;
  description: string;
  icon_name: string;
  url: string;
}

interface MegaMenuSection {
  title: string;
  items: MegaMenuItem[];
}

interface FeaturedResource {
  image_url: string;
  title: string;
  description: string;
  link_text: string;
  url: string;
}

interface Props {
  data?: {
    logo?: any;
    navbarLinks?: Array<{ title: string; url: string }>;
    navbarCtaPrimary?: { text: string; url: string };
    navbarCtaSecondary?: { text: string; url: string };
  };
}

const { data } = Astro.props;

const logoUrl = data?.logo ? urlFor(data.logo).width(200).url() : null;
const links = data?.navbarLinks || [
  { title: 'Inicio', url: '/' },
  { title: 'Ejemplo de Tripcket', url: '/ejemplo' },
  { title: 'Blog', url: '/blog' },
  { title: 'Destinos', url: '/destinos' },
  { title: 'Experiencias', url: '/experiencias' },
  { title: 'Empresa', url: '/empresa' },
  { title: 'Contacto', url: '/contacto' },
];

const ctaPrimary = data?.navbarCtaPrimary || { text: 'Ingresar', url: '/ingresar' };
const ctaSecondary = data?.navbarCtaSecondary || { text: 'Crear', url: '/crear' };

const megaMenuSections: MegaMenuSection[] = [
  {
    title: 'Para viajeros',
    items: [
      { label: 'Destinos', description: 'Explora los mejores lugares', icon_name: 'map', url: '/destinos' },
      { label: 'Experiencias', description: 'Actividades únicas', icon_name: 'sparkles', url: '/experiencias' },
      { label: 'Guías locales', description: 'Conoce a los habitantes', icon_name: 'user-group', url: '/guias' },
      { label: 'Blog', description: 'Consejos y tips de viaje', icon_name: 'document-text', url: '/blog' },
    ]
  },
  {
    title: 'Para negocios',
    items: [
      { label: 'Sé un anfitrión', description: 'Comparte tu experiencia', icon_name: 'home', url: '/anfitrion' },
      { label: 'Partners', description: 'Colabora con nosotros', icon_name: 'users', url: '/partners' },
      { label: 'Empresas', description: 'Viajes corporativos', icon_name: 'briefcase', url: '/corporativo' },
      { label: 'Contacto comercial', description: 'Hablemos de negocios', icon_name: 'at-symbol', url: '/contacto-empresarial' },
    ]
  }
];

const featuredResources: FeaturedResource[] = [
  {
    image_url: 'https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=400&h=250&fit=crop',
    title: 'Top 10 destinos 2024',
    description: 'Los lugares que no puedes perderte',
    link_text: 'Leer más',
    url: '/top-destinos'
  },
  {
    image_url: 'https://images.unsplash.com/photo-1506929562872-bb421503ef21?w=400&h=250&fit=crop',
    title: 'Viaja como local',
    description: 'Experiencias auténticas garantizadas',
    link_text: 'Descubrir',
    url: '/como-local'
  }
];
---

<nav id="site-nav" class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-[#92cdcf]/20">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      {logoUrl ? (
        <img src={logoUrl} alt="Tripcket" class="h-10 w-auto object-contain" />
      ) : (
        <span class="text-2xl font-bold gradient-text-solid">Tripcket</span>
      )}
    </a>
    
    <div class="hidden md:flex items-center gap-8">
      {links.map((link, i) => (
        <a href={link.url} class="nav-link text-sm text-gray-600 hover:text-gray-900" data-nav-link={i}>{link.title}</a>
      ))}
      <div class="relative">
        <button 
          id="mega-menu-trigger"
          class="nav-link text-sm text-gray-600 hover:text-gray-900 flex items-center gap-1 cursor-pointer"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Más
          <Icon name="heroicons:chevron-down" class="w-4 h-4 transition-transform" id="mega-menu-arrow" />
        </button>
        
        <div id="mega-menu" class="hidden absolute left-1/2 -translate-x-1/2 top-full mt-2 w-[900px] max-w-[95vw] bg-white rounded-2xl shadow-2xl border border-[#92cdcf]/20 p-6 z-50" role="menu">
          <div class="grid grid-cols-4 gap-6">
            {megaMenuSections.map((section, sIndex) => (
              <div class={`${sIndex === 0 ? 'col-span-1' : 'col-span-1'}`}>
                <h3 class="font-semibold text-gray-800 mb-4 text-sm uppercase tracking-wide">{section.title}</h3>
                <ul class="space-y-3">
                  {section.items.map((item) => (
                    <li>
                      <a href={item.url} class="flex items-start gap-3 group/item">
                        <div class="w-8 h-8 rounded-full gradient-border flex items-center justify-center flex-shrink-0">
                          <Icon name={`heroicons:${item.icon_name}`} class="w-4 h-4" />
                        </div>
                        <div>
                          <span class="text-sm font-medium text-gray-800 block group-hover/item:text-[#92cdcf] transition-colors">{item.label}</span>
                          <span class="text-xs text-gray-500">{item.description}</span>
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            
            <div class="col-span-2 border-l border-gray-100 pl-6">
              <h3 class="font-semibold text-gray-800 mb-4 text-sm uppercase tracking-wide">Destacados</h3>
              <div class="grid grid-cols-2 gap-4">
                {featuredResources.map((resource) => (
                  <a href={resource.url} class="group/resource block">
                    <div class="aspect-video rounded-xl overflow-hidden mb-2 border border-[#92cdcf]/20">
                      <img src={resource.image_url} alt={resource.title} class="w-full h-full object-cover group-hover/resource:scale-105 transition-transform duration-300" />
                    </div>
                    <h4 class="text-sm font-semibold text-gray-800 mb-1">{resource.title}</h4>
                    <p class="text-xs text-gray-500 mb-2">{resource.description}</p>
                    <span class="text-xs text-[#92cdcf] font-medium">{resource.link_text} →</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
          
          <div class="mt-4 pt-4 border-t border-gray-100">
            <a href="/todos" class="text-sm text-gray-600 hover:text-[#92cdcf] transition-colors flex items-center justify-center gap-1">
              Ver todos los enlaces
              <Icon name="heroicons:arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <a href={ctaPrimary.url} class="px-4 py-2 text-sm gradient-border rounded-full font-medium" data-nav-cta-primary>{ctaPrimary.text}</a>
      <a href={ctaSecondary.url} class="px-4 py-2 text-sm gradient-button rounded-full font-medium" data-nav-cta-secondary>{ctaSecondary.text}</a>
    </div>
  </div>
</nav>

<script>
  const trigger = document.getElementById('mega-menu-trigger');
  const megaMenu = document.getElementById('mega-menu');
  const arrow = document.getElementById('mega-menu-arrow');
  
  if (trigger && megaMenu) {
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      const isOpen = !megaMenu.classList.contains('hidden');
      
      if (isOpen) {
        megaMenu.classList.add('hidden');
        trigger.setAttribute('aria-expanded', 'false');
        arrow?.classList.remove('rotate-180');
      } else {
        megaMenu.classList.remove('hidden');
        trigger.setAttribute('aria-expanded', 'true');
        arrow?.classList.add('rotate-180');
      }
    });

    document.addEventListener('click', (e) => {
      if (!megaMenu.contains(e.target as Node) && !trigger.contains(e.target as Node)) {
        megaMenu.classList.add('hidden');
        trigger.setAttribute('aria-expanded', 'false');
        arrow?.classList.remove('rotate-180');
      }
    });
  }
</script>
