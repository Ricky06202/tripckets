---
import { Icon } from 'astro-icon/components';

import { urlFor } from '../lib/sanity';

interface Props {
  data?: {
    logo?: any;
    navbarLinks?: Array<{ title: string; url: string }>;
    navbarCtaPrimary?: { text: string; url: string };
    navbarCtaSecondary?: { text: string; url: string };
  };
}

const { data } = Astro.props;

const logoUrl = data?.logo ? urlFor(data.logo).width(200).url() : null;
const links = data?.navbarLinks || [
  { title: 'Inicio', url: '/' },
  { title: 'Ejemplo de Tripcket', url: '/ejemplo' },
  { title: 'Blog', url: '/blog' },
  { title: 'Destinos', url: '/destinos' },
  { title: 'Experiencias', url: '/experiencias' },
  { title: 'Empresa', url: '/empresa' },
  { title: 'Contacto', url: '/contacto' },
];

const ctaPrimary = data?.navbarCtaPrimary || { text: 'Ingresar', url: '/ingresar' };
const ctaSecondary = data?.navbarCtaSecondary || { text: 'Crear', url: '/crear' };
---

<nav id="site-nav" class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-[#92cdcf]/20">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      {logoUrl ? (
        <img src={logoUrl} alt="Tripcket" class="h-10 w-auto object-contain" />
      ) : (
        <span class="text-2xl font-bold gradient-text-solid">Tripcket</span>
      )}
    </a>
    
    <div class="hidden md:flex items-center gap-8">
      {links.map((link, i) => (
        <a href={link.url} class="nav-link text-sm text-gray-600 hover:text-gray-900" data-nav-link={i}>{link.title}</a>
      ))}
      <div class="relative group">
        <button class="nav-link text-sm text-gray-600 hover:text-gray-900 flex items-center gap-1">
          Más
          <Icon name="heroicons:chevron-down" class="w-4 h-4" />
        </button>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <a href={ctaPrimary.url} class="px-4 py-2 text-sm gradient-border rounded-full font-medium" data-nav-cta-primary>{ctaPrimary.text}</a>
      <a href={ctaSecondary.url} class="px-4 py-2 text-sm gradient-button rounded-full font-medium" data-nav-cta-secondary>{ctaSecondary.text}</a>
    </div>
  </div>
</nav>
