---
import { Icon } from 'astro-icon/components';

interface CTAButton {
  text: string;
  url: string;
}

interface Props {
  data?: {
    title?: string;
    subtitle?: string;
    description?: string;
    bullets?: string[];
    ctaPrimary?: CTAButton;
    ctaSecondary?: CTAButton;
    image?: {
      asset?: {
        url?: string;
      };
    };
  };
}

const { data } = Astro.props;

const imageUrl = data?.image?.asset?.url;
const title = data?.title || 'Boquete, Panamá te espera';
const subtitle = data?.subtitle || 'Panamá';
const description = data?.description || 'Descubre Boquete, un paraíso escondido en las tierras altas de Panamá. Con su clima perfecto, paisajes espectaculares y comunidad acogedora, es el destino ideal para tu próximo Tripcket.';
const bullets = data?.bullets || [
  'Playas pristine y arrecifes de coral',
  'Selva tropical con biodiversidad única',
  'Cultura guna y tradiciones ancestrales',
];
const ctaPrimary = data?.ctaPrimary || { text: 'Descubrir', url: '/descubrir' };
const ctaSecondary = data?.ctaSecondary || { text: 'Más', url: '/mas' };
---

<section class="py-20 bg-cream-50" data-aos="fade-up">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-16" data-aos="fade-up" data-aos-delay="100">
      {title}
    </h2>

    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="placeholder-rect aspect-[4/3] rounded-3xl overflow-hidden order-2 lg:order-1" data-aos="fade-right" data-aos-delay="200">
        {imageUrl ? (
          <img src={imageUrl} alt={title} class="w-full h-full object-cover" />
        ) : (
          <Icon name="heroicons:photo" class="w-16 h-16 opacity-50" />
        )}
      </div>

      <div class="order-1 lg:order-2" data-aos="fade-left" data-aos-delay="300">
        <p class="text-lg text-gray-700 mb-6">
          {description}
        </p>
        
        <ul class="space-y-3 mb-8">
          {bullets.map((bullet, index) => (
            <li class="flex items-center gap-3" data-aos="fade-up" data-aos-delay={400 + (index * 100)}>
              <svg class="w-5 h-5 gradient-text flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>

        <div class="flex flex-wrap gap-4">
          <a href={ctaPrimary.url} class="px-6 py-3 gradient-button rounded-full font-medium">{ctaPrimary.text}</a>
          <a href={ctaSecondary.url} class="px-6 py-3 text-gray-700 font-medium flex items-center gap-1 hover:gap-2 transition-all">
            {ctaSecondary.text}
            <Icon name="heroicons:arrow-right" class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
