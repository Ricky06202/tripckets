---
import { Icon } from 'astro-icon/components';

interface Traveler {
  title: string;
  description: string;
}

interface Props {
  travelers?: Traveler[];
}

const { travelers } = Astro.props;

const sectionTravelers = travelers || [
  { title: 'Aventura en la naturaleza', description: 'Explora senderos y paisajes únicos.' },
  { title: 'Escape cultural', description: 'Sumérgete en historia y tradiciones.' },
  { title: 'Relax playero', description: 'Disfruta de las mejores playas.' },
  { title: 'Gastronomía local', description: 'Saborea platos típicos auténticos.' },
];
---

<section class="py-20" data-aos="fade-up">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-16" data-aos="fade-up" data-aos-delay="100">
      Tripckets para cada <span class="gradient-text-solid">tipo de viajero</span>
    </h2>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {sectionTravelers.map((traveler, index) => (
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm card-hover" data-aos="fade-up" data-aos-delay={200 + (index * 100)}>
          <div class="placeholder-rect aspect-[4/3]">
            <Icon name="heroicons:photo" class="w-8 h-8 opacity-50" />
          </div>
          <div class="p-6">
            <h3 class="font-semibold text-lg text-center mb-2">{traveler.title}</h3>
            <p class="text-gray-600 text-sm text-center">{traveler.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
