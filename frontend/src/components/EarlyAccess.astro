---
interface Props {
  data?: {
    title?: string;
    subtitle?: string;
    placeholder?: string;
    buttonText?: string;
  };
}

const { data } = Astro.props;

const title = data?.title || 'Tu viaje comienza aquí';
const subtitle = data?.subtitle || 'Ingresa tu número y sé el primero en descubrir experiencias únicas.';
const placeholder = data?.placeholder || 'Tu número';
const buttonText = data?.buttonText || 'Entrar';
---

<section class="py-16" data-aos="fade-up">
  <div class="max-w-3xl mx-auto px-6">
    <div class="gradient-bg rounded-3xl p-8 md:p-12 text-center" data-aos="zoom-in" data-aos-delay="100">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">
        {title}
      </h2>
      <p class="text-gray-700 mb-8">
        {subtitle}
      </p>
      
      <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
        <input 
          type="tel" 
          placeholder={placeholder}
          class="flex-1 px-6 py-3 rounded-full bg-white/90 backdrop-blur-sm border border-white/50 text-gray-800 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white/50"
        />
        <button type="submit" class="px-8 py-3 bg-gray-800 text-white rounded-full font-semibold hover:bg-gray-700 transition-colors">
          {buttonText}
        </button>
      </form>
    </div>
  </div>
</section>
