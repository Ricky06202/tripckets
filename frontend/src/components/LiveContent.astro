---
const projectId = import.meta.env.PUBLIC_SANITY_PROJECT_ID || 'TU_PROJECT_ID';
const dataset = import.meta.env.PUBLIC_SANITY_DATASET || 'production';
---

<script define:vars={{ projectId, dataset }}>
(async function() {
  if (!projectId || projectId === 'TU_PROJECT_ID') return;

  async function fetchFromSanity(query) {
    const url = `https://${projectId}.api.sanity.io/v2024-01-01/data/query/${dataset}?query=${encodeURIComponent(query)}`;
    try {
      const res = await fetch(url);
      const data = await res.json();
      return data.result;
    } catch (e) {
      return null;
    }
  }

  const siteSettings = await fetchFromSanity('*[_type == "siteSettings"][0]');

  if (siteSettings) {
    const nav = document.getElementById('site-nav');
    if (nav && siteSettings.logo?.asset?._ref) {
      const ref = siteSettings.logo.asset._ref;
      const match = ref.match(/^image-([a-f0-9]+)-\d+x\d+-([a-z]+)$/);
      if (match) {
        const assetId = match[1];
        const ext = match[2];
        const logoUrl = `https://cdn.sanity.io/images/${projectId}/${dataset}/${assetId}.${ext}`;
        const logoLink = nav.querySelector('a[href="/"]');
        if (logoLink) {
          logoLink.innerHTML = `<img src="${logoUrl}" alt="Tripcket" class="h-10 w-auto object-contain" />`;
        }
      }
    }

    if (siteSettings.navbarLinks && siteSettings.navbarLinks.length > 0) {
      const linksContainer = nav.querySelector('[class*="hidden md:flex"]');
      if (linksContainer) {
        const links = linksContainer.querySelectorAll('[data-nav-link]');
        siteSettings.navbarLinks.forEach((link, i) => {
          if (links[i]) {
            links[i].textContent = link.title;
            if (link.url) links[i].href = link.url;
          }
        });
      }
    }

    if (siteSettings.navbarCtaPrimary) {
      const ctaPrimary = document.querySelector('[data-nav-cta-primary]');
      if (ctaPrimary) {
        ctaPrimary.textContent = siteSettings.navbarCtaPrimary.text || ctaPrimary.textContent;
        if (siteSettings.navbarCtaPrimary.url) ctaPrimary.href = siteSettings.navbarCtaPrimary.url;
      }
    }

    if (siteSettings.navbarCtaSecondary) {
      const ctaSecondary = document.querySelector('[data-nav-cta-secondary]');
      if (ctaSecondary) {
        ctaSecondary.textContent = siteSettings.navbarCtaSecondary.text || ctaSecondary.textContent;
        if (siteSettings.navbarCtaSecondary.url) ctaSecondary.href = siteSettings.navbarCtaSecondary.url;
      }
    }
  }

  const hero = await fetchFromSanity('*[_type == "hero"][0]{title,subtitle,badgeText,ctaButtons,image}');
  if (hero) {
    const heroSection = document.getElementById('inicio');
    if (heroSection) {
      const h1 = heroSection.querySelector('h1');
      if (h1 && hero.title) h1.textContent = hero.title;

      const subtitle = heroSection.querySelector('p.text-base');
      if (subtitle && hero.subtitle) subtitle.textContent = hero.subtitle;

      const badge = heroSection.querySelector('[class*="gradient-bg"] p');
      if (badge && hero.badgeText) badge.textContent = hero.badgeText;

      const buttons = heroSection.querySelectorAll('a.gradient-button, a.gradient-border');
      if (hero.ctaButtons && buttons.length > 0) {
        buttons.forEach((btn, i) => {
          if (hero.ctaButtons[i]) {
            btn.textContent = hero.ctaButtons[i].text || btn.textContent;
            if (hero.ctaButtons[i].url) btn.href = hero.ctaButtons[i].url;
          }
        });
      }

      const heroImageContainer = heroSection.querySelector('.placeholder-rect');
      if (heroImageContainer && hero.image?.asset?._ref) {
        const ref = hero.image.asset._ref;
        const match = ref.match(/^image-([a-f0-9]+)-\d+x\d+-([a-z]+)$/);
        if (match) {
          const assetId = match[1];
          const ext = match[2];
          const heroImageUrl = `https://cdn.sanity.io/images/${projectId}/${dataset}/${assetId}.${ext}`;
          heroImageContainer.innerHTML = `<img src="${heroImageUrl}" alt="${hero.title || 'Hero'}" class="w-full h-full object-cover" />`;
        }
      }
    }
  }
})();
</script>
