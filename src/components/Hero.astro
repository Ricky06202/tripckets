---
import { Icon } from 'astro-icon/components';

interface CTAButton {
  text: string;
  url: string;
  style?: string;
}

interface Props {
  data?: {
    title?: string;
    subtitle?: string;
    badgeText?: string;
    ctaButtons?: CTAButton[];
  };
}

const { data } = Astro.props;

const title = data?.title || 'Tu boleto para descubrir experiencias auténticas';
const subtitle = data?.subtitle || 'Tripcket te conecta con viajes únicos diseñados por locales, eliminando intermediarios y creando memorias genuinas.';
const badgeText = data?.badgeText || 'Un boleto, infinitas posibilidades';
const ctaButtons = data?.ctaButtons || [
  { text: 'Crear', url: '/crear', style: 'primary' },
  { text: 'Explorar', url: '/explorar', style: 'secondary' },
];
---

<section id="inicio" class="relative min-h-screen flex items-center pt-20 overflow-hidden" data-aos="fade-up">
  <div class="organic-shape w-64 md:w-96 h-64 md:h-96 bg-[#fff7ad]/30 -top-20 -left-20"></div>
  <div class="organic-shape w-48 md:w-80 h-48 md:h-80 bg-[#92cdcf]/20 top-1/2 right-0"></div>
  
  <div class="max-w-7xl mx-auto px-6 py-8 md:py-12 grid md:grid-cols-2 gap-8 md:gap-12 items-center">
    <div class="text-center md:text-left" data-aos="fade-right" data-aos-delay="100">
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-4 md:mb-6">
        {title}
      </h1>
      <p class="text-base md:text-lg text-gray-600 mb-6 md:mb-8 max-w-lg mx-auto md:mx-0">
        {subtitle}
      </p>
      <div class="flex flex-wrap gap-4 justify-center md:justify-start">
        {ctaButtons.map(button => (
          button.style === 'primary' 
            ? <a href={button.url} class="px-6 md:px-8 py-3 gradient-button rounded-full font-semibold text-sm md:text-base">{button.text}</a>
            : <a href={button.url} class="px-6 md:px-8 py-3 gradient-border rounded-full font-semibold gradient-text text-sm md:text-base">{button.text}</a>
        ))}
      </div>
    </div>

    <div class="placeholder-rect aspect-square rounded-2xl md:rounded-3xl" data-aos="fade-left" data-aos-delay="200">
      <Icon name="heroicons:photo" class="w-12 md:w-16 h-12 md:h-16 opacity-50" />
    </div>
  </div>

  <div class="absolute bottom-4 md:bottom-8 left-1/2 transform -translate-x-1/2 mx-4 gradient-bg px-6 md:px-8 py-3 md:py-4 rounded-xl" data-aos="fade-up" data-aos-delay="400">
    <p class="text-gray-800 text-center font-medium text-sm md:text-base whitespace-nowrap">{badgeText}</p>
  </div>
</section>
