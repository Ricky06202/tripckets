---
import { Icon } from 'astro-icon/components';
---

<section id="inicio" class="relative min-h-screen flex items-center pt-20 overflow-hidden" data-aos="fade-up">
  <div class="organic-shape w-64 md:w-96 h-64 md:h-96 bg-orange-100 -top-20 -left-20"></div>
  <div class="organic-shape w-48 md:w-80 h-48 md:h-80 bg-orange-50 top-1/2 right-0"></div>
  
  <div class="max-w-7xl mx-auto px-6 py-8 md:py-12 grid md:grid-cols-2 gap-8 md:gap-12 items-center">
    <div class="text-center md:text-left" data-aos="fade-right" data-aos-delay="100">
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-4 md:mb-6">
        Tu boleto para descubrir <span class="gradient-text">experiencias auténticas</span>
      </h1>
      <p class="text-base md:text-lg text-gray-600 mb-6 md:mb-8 max-w-lg mx-auto md:mx-0">
        Tripcket te conecta con viajes únicos diseñados por locales, eliminando intermediarios y creando memorias genuinas.
      </p>
      <div class="flex flex-wrap gap-4 justify-center md:justify-start">
        <a href="#crear" class="px-6 md:px-8 py-3 gradient-button rounded-full font-semibold text-sm md:text-base">Crear</a>
        <a href="#explorar" class="px-6 md:px-8 py-3 gradient-border rounded-full font-semibold text-orange-500 text-sm md:text-base">Explorar</a>
      </div>
    </div>

    <div class="placeholder-rect aspect-square rounded-2xl md:rounded-3xl" data-aos="fade-left" data-aos-delay="200">
      <Icon name="heroicons:photo" class="w-12 md:w-16 h-12 md:h-16 opacity-50" />
    </div>
  </div>

  <div class="absolute bottom-4 md:bottom-8 left-1/2 transform -translate-x-1/2 mx-4 bg-gradient-to-r from-[#C4913B] to-[#F7B538] px-6 md:px-8 py-3 md:py-4 rounded-xl" data-aos="fade-up" data-aos-delay="400">
    <p class="text-white text-center font-medium text-sm md:text-base whitespace-nowrap">Un boleto, infinitas posibilidades</p>
  </div>
</section>
