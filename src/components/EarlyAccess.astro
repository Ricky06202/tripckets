---
---

<section class="py-16" data-aos="fade-up">
  <div class="max-w-3xl mx-auto px-6">
    <div class="bg-gradient-to-r from-[#C4913B] to-[#F7B538] rounded-3xl p-8 md:p-12 text-center" data-aos="zoom-in" data-aos-delay="100">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Tu viaje comienza aquí
      </h2>
      <p class="text-white/90 mb-8">
        Ingresa tu número y sé el primero en descubrir experiencias únicas.
      </p>
      
      <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
        <input 
          type="tel" 
          placeholder="Tu número" 
          class="flex-1 px-6 py-3 rounded-full bg-white/20 backdrop-blur-sm border border-white/30 text-white placeholder-white/70 focus:outline-none focus:ring-2 focus:ring-white/50"
        />
        <button type="submit" class="px-8 py-3 bg-white text-[#C4913B] rounded-full font-semibold hover:bg-white/90 transition-colors">
          Entrar
        </button>
      </form>
    </div>
  </div>
</section>
