---
import { Icon } from 'astro-icon/components';
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-orange-100">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="text-2xl font-bold gradient-text">Tripcket</a>
    
    <div class="hidden md:flex items-center gap-8">
      <a href="#inicio" class="nav-link text-sm text-gray-600 hover:text-gray-900">Inicio</a>
      <a href="#ejemplo" class="nav-link text-sm text-gray-600 hover:text-gray-900">Ejemplo de Tripcket</a>
      <a href="#blog" class="nav-link text-sm text-gray-600 hover:text-gray-900">Blog</a>
      <div class="relative group">
        <button class="nav-link text-sm text-gray-600 hover:text-gray-900 flex items-center gap-1">
          Más
          <Icon name="heroicons:chevron-down" class="w-4 h-4" />
        </button>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <a href="#ingresar" class="px-4 py-2 text-sm gradient-border rounded-full text-orange-500 font-medium">Ingresar</a>
      <a href="#crear" class="px-4 py-2 text-sm gradient-button rounded-full font-medium">Crear</a>
    </div>
  </div>
</nav>
