---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CoreValue from '../components/CoreValue.astro';
import Problem from '../components/Problem.astro';
import Solution from '../components/Solution.astro';
import Process from '../components/Process.astro';
import Personalization from '../components/Personalization.astro';
import Examples from '../components/Examples.astro';
import Destination from '../components/Destination.astro';
import EarlyAccess from '../components/EarlyAccess.astro';
import Expansion from '../components/Expansion.astro';
import Benefits from '../components/Benefits.astro';
import Impact from '../components/Impact.astro';
import Testimonials from '../components/Testimonials.astro';
import Footer from '../components/Footer.astro';
import { defaultData } from '../lib/defaultData';

let pageData = { ...defaultData };

try {
  const { getAllPageData } = await import('../lib/queries');
  const sanityData = await getAllPageData();
  
  if (sanityData && sanityData.siteSettings) {
    pageData = {
      ...defaultData,
      ...sanityData,
      expansionFeatures: sanityData.expansionData?.features || defaultData.expansionFeatures,
      expansion: sanityData.expansionData?.settings || defaultData.expansion,
      features: sanityData.features || defaultData.features,
      problems: sanityData.problems || defaultData.problems,
      solution: sanityData.solution || defaultData.solution,
      processSteps: sanityData.processSteps || defaultData.processSteps,
      personalization: sanityData.personalization || defaultData.personalization,
      travelerTypes: sanityData.travelerTypes || defaultData.travelerTypes,
      destination: sanityData.destination || defaultData.destination,
      earlyAccess: sanityData.earlyAccess || defaultData.earlyAccess,
      benefits: sanityData.benefits || defaultData.benefits,
      impacts: sanityData.impacts || defaultData.impacts,
      testimonials: sanityData.testimonials || defaultData.testimonials,
    };
  }
} catch (e) {
  console.log('Using default data (Sanity not configured)');
}
---

<Layout>
  <Header data={pageData.siteSettings} />
  <main>
    <Hero data={pageData.hero} />
    <CoreValue 
      title={pageData.coreValue?.title} 
      features={pageData.features} 
    />
    <Problem problems={pageData.problems} />
    <Solution data={pageData.solution} />
    <Process steps={pageData.processSteps} />
    <Personalization data={pageData.personalization} />
    <Examples travelers={pageData.travelerTypes} />
    <Destination data={pageData.destination} />
    <EarlyAccess data={pageData.earlyAccess} />
    <Expansion 
      data={pageData.expansion} 
      features={pageData.expansionFeatures} 
    />
    <Benefits benefits={pageData.benefits} />
    <Impact impacts={pageData.impacts} />
    <Testimonials testimonials={pageData.testimonials} />
  </main>
  <Footer data={pageData.siteSettings} />
</Layout>
